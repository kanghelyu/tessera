,"ma-c-a04c494c0f6eb53d0799","ma-c-a21fe5ec79215047eed0","ma-c-a2b73dfa30565aa84c02","ma-c-ab788942d224ab4bbfd2","ma-c-b3284b979c410aeb4c5d","ma-c-b6f074b263159bb9cb16","ma-c-c5247051cead76d47033","ma-c-d0cbbacda2f695b76c0f","ma-c-e3d763259b831db2b8ab","ma-c-e4886f56824f72542688","ma-c-e5c35a45b4c0a557bee1","ma-c-eadd74e7c8f7b1391748","ma-c-f1d199cdab05c03af077"],"leaves":["ma-c-01e423be3666414ed7ce","ma-c-024fada47f97a8ad3e6f","ma-c-03270e766e092526dc9f","ma-c-0bc3f57a464328efacf4","ma-c-1642253319f5c2ebaad9","ma-c-352c335f68240ea2059d","ma-c-37b6b712cdba1fdf29e7","ma-c-3cdca146010f95b5c515","ma-c-4d88fccdf04d7fcda762","ma-c-5035c8a68ac684d00071","ma-c-57f368d2ef17eab465dd","ma-c-718ffe0d49643f7bcad7","ma-c-7612165069e048d069d9","ma-c-79e3140f150b5ec2c7c6","ma-c-7a664ef63d1199bbf112","ma-c-7fdf182180288dd99fc8","ma-c-81ae9ac44da25fb10cd8","ma-c-8caade563f64212a4dbf","ma-c-8e74b588a409aacb568f","ma-c-8f9690764d1c11229e1e","ma-c-9fe851d1b3f5af6236c6","ma-c-a21fe5ec79215047eed0","ma-c-a2b73dfa30565aa84c02","ma-c-b26df91b05bf0ab29ada","ma-c-b3284b979c410aeb4c5d","ma-c-b56e1c38ca0edbeab1b2","ma-c-b6f074b263159bb9cb16","ma-c-b8ea11345fe2056ff391","ma-c-c5247051cead76d47033","ma-c-d0cbbacda2f695b76c0f","ma-c-e4886f56824f72542688","ma-c-e5c35a45b4c0a557bee1","ma-c-e9a83589850f818445d2","ma-c-f1d199cdab05c03af077"],"papers":{"arXiv:1403.2645":{"abstract":"We give a method for constructing a regularizing decomposition of a matrix pencil, which is formulated in terms of the linear mappings. We prove that two pencils are topologically equivalent if and only if their regularizing decompositions coincide up to permutation of summands and their regular parts coincide up to homeomorphisms of their spaces.","authors":["Vyacheslav Futorny","Tetiana Rybalkina","Vladimir V. Sergeichuk"],"year":"2014"},"arXiv:1611.08716":{"abstract":"Let $\\cal A$ and $\\cal B$ be two systems consisting of the same vector spaces $\\mathbb C^{n_1},\\dots,\\mathbb C^{n_t}$ and bilinear or sesquilinear forms $A_i,B_i:\\mathbb C^{n_{k(i)}}\\times\\mathbb C^{n_{l(i)}}\\to\\mathbb C$, for $i=1,\\dots,s$. We prove that $\\cal A$ is transformed to $\\cal B$ by homeomorphisms within $\\mathbb C^{n_1},\\dots,\\mathbb C^{n_t}$ if and only if $\\cal A$ is transformed to $","authors":["Carlos M. da Fonseca","Vyacheslav Futorny","Tetiana Rybalkina"],"year":"2016"},"arXiv:1704.04670":{"abstract":"W.E. Roth (1952) proved that the matrix equation $AX-XB=C$ has a solution if and only if the matrices $\\left[\\begin{matrix}A&C\\\\0&B\\end{matrix}\\right]$ and $\\left[\\begin{matrix}A&0\\\\0&B\\end{matrix}\\right]$ are similar. A. Dmytryshyn and B. Kågström (2015) extended Roth's criterion to systems of matrix equations $A_iX_{i'}M_i-N_iX_{i''}^{σ_i} B_i=C_i$ $(i=1,\\dots,s)$ with unknown matrices $X_1,\\dot","authors":["Andrii Dmytryshyn","Vyacheslav Futorny","Tetiana Klymchuk"],"year":"2017"},"arXiv:1011.0040":{"abstract":"Each square complex matrix is unitarily similar to an upper triangular matrix with diagonal entries in any prescribed order. Let A and B be upper triangular n-by-n matrices that (i) are not similar to direct sums of matrices of smaller sizes, or (ii) are in general position and have the same main diagonal. We prove that A and B are unitarily similar if and only if ||h(A_k)||=||h(B_k)|| for all com","authors":["Douglas Farenick","Vyacheslav Futorny","Tatiana G. Gerasimova"],"year":"2010"},"arXiv:1112.3682":{"abstract":"A square matrix is nonderogatory if its Jordan blocks have distinct eigenvalues. We give canonical forms (i) for nonderogatory complex matrices up to unitary similarity and (ii) for pairs of complex matrices up to similarity, in which one matrix has distinct eigenvalues. The types of these canonical forms are given by undirected and, respectively, directed graphs with no undirected cycles.","authors":["Vyacheslav Futorny","Roger A. Horn","Vladimir V. Sergeichuk"],"year":"2011"},"arXiv:1004.3590":{"abstract":"We construct the Hasse diagrams $G_2$ and $G_3$ for the closure ordering on the sets of congruence classes of $2\\times 2$ and $3\\times 3$ complex matrices. In other words, we construct two directed graphs whose vertices are $2\\times 2$ or, respectively, $3\\times 3$ canonical matrices under congruence and there is a directed path from $A$ to $B$ if and only if $A$ can be transformed by an arbitrari","authors":["Andrii Dmytryshyn","Vyacheslav Futorny","Bo Kågström"],"year":"2010"},"arXiv:1611.04527":{"abstract":"The matrix equation $AX-XB=C$ has a solution if and only if the matrices [A&C\\\\0&B] and [A &0\\\\0 & B] are similar. This criterion was proved over a field by W.E. Roth (1952) and over the skew field of quaternions by Huang Liping (1996). H.K. Wimmer (1988) obtained an analogous criterion for the matrix equation $X-AXB=C$ over a field. We extend these criteria to the matrix equations $AX-\\widehat XB","authors":["Vyacheslav Futorny","Tetiana Klymchuk","Vladimir V. Sergeichuk"],"year":"2016"},"arXiv:2009.13894":{"abstract":"Two matrix vector spaces $V,W\\subset \\mathbb C^{n\\times n}$ are said to be equivalent if $SVR=W$ for some nonsingular $S$ and $R$. These spaces are congruent if $R=S^T$. We prove that if all matrices in $V$ and $W$ are symmetric, or all matrices in $V$ and $W$ are skew-symmetric, then $V$ and $W$ are congruent if and only if they are equivalent. Let $F: U\\times\\dots\\times U\\to V$ and $G: U'\\times\\","authors":["Genrich R. Belitskii","Vyacheslav Futorny","Mikhail Muzychuk"],"year":"2020"},"arXiv:1810.09219":{"abstract":"In representation theory, a classification problem is called wild if it contains the problem of classifying matrix pairs up to simultaneous similarity. The latter problem is considered as hopeless; it contains the problem of classifying an arbitrary finite system of vector spaces and linear mappings between them. We prove that an analogous \"universal\" problem in the theory of tensors of order at m","authors":["Vyacheslav Futorny","Joshua A. Grochow","Vladimir V. Sergeichuk"],"year":"2018"},"arXiv:1208.5414":{"abstract":"For a given poset, we consider its representations by systems of subspaces of a unitary space ordered by inclusion. We classify such systems for all posets for which an explicit classification is possible.","authors":["Vitalij M. Bondarenko","Vyacheslav Futorny","Tatiana Klimchuk"],"year":"2012"},"arXiv:0710.0928":{"abstract":"We give canonical matrices of bilinear or sesquilinear forms UxV-->C, (V/U)xV-->C, in which V is a vector space over the field C of complex numbers and U is its subspace.","authors":["Vyacheslav Futorny","Vladimir V. Sergeichuk"],"year":"2007"},"arXiv:2112.10911":{"abstract":"This is a survey of some recent progress on quantum symmetric pairs and applications. The topics include quasi K-matrices, $\\imath$Schur duality, canonical bases, super Kazhdan-Lusztig theory, $\\imath$Hall algebras, current presentations for affine $\\imath$quantum groups, and braid group actions.","authors":["Weiqiang Wang"],"year":"2021"}}}