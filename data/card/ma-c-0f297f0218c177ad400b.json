{"card":{"card_id":"ma-c-0f297f0218c177ad400b","statement":"P_{W_{k_2}^{r_2}}(X) = P_{V(\\psi)_{k_2}}(X) = \\frac{1}{r_2}\n{{\\sum_{t\\mid r_2}}} C_t(r_2) P_W(X^t)^{\\frac{r_2}{t}}.","source_id":"arXiv:1006.5663","cluster":"representation_theory","statement_sha256":"a0c5981632afd2fe16fe4e8509a9520a54347739aa9d594c1ac6b0a129fe570e","kind":"equation","label":"Equation 5.5","ref_key":"eq-5.5","name":"","order":24,"deps":[],"cite_keys":[],"provenance":{"source_url":"https://arxiv.org/abs/1006.5663","harvest_mode":"arxiv_eprint","payload_sha256":"36189d567ec38d5e2b3ffdaa6921097a71b801f3757882ae5c29e5ef192671df","line":1025,"origin":"latex_env:equation","retrieved_at":"2026-09-29T14:08:13+08:00"},"wash":{"version":"cardwash.v3","stages":["segment","purify","classify","dedupe","emit"],"numbering":"document_order_with_label_heuristic","detail":{"stripped_proof":false,"chars":115,"math_hints":15}}},"paper":{"source_id":"arXiv:1006.5663","title":"Representations of Loop Kac-Moody Lie Algebras","abstract":"We study representations of the Loop Kac-Moody Lie algebra g \\otimes A, where g is any Kac-Moody algebra and A is a ring of Laurent polynomials in n commuting variables. In particular, we study representations with finite dimensional weight spaces and their graded versions. When we specialize g to be a finite dimensional or affine Lie algebra we obtain modules for toroidal Lie algebras.","authors":["S. Eswara Rao","Vyacheslav Futorny"],"year":"2010","url":"https://arxiv.org/abs/1006.5663","cluster":"representation_theory","macros":{"gg":"{\\mathfrak{g}}","hh":"{\\mathcal H}","CC":"{\\mathbb C}","NN":"{\\mathbb N}","ZZ":"{\\mathbb Z}","lr":"\\:\\raisebox{-0.6ex}{$\\stackrel{p_{\\xi^k}}{\\to}$}\\:","gtimes":"{\\gg\\otimes A}","gof":"{\\gg_{\\rm aff}\\otimes A}","gf":"{\\gg_{\\rm aff}}","oG":"{\\overline{\\Gamma}}"},"macros_override":["CC","NN","ZZ","gf","gg","gof","gtimes","hh","lr","oG"]},"deps":[],"dependents":[]}