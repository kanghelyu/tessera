{"card":{"card_id":"ma-c-5e22a2bb16f3851f12dd","statement":"\\notag\n\\pr([s_{m,-i}(e_{0,-2}), s_{-j,k}(\\rdet \\Omega_{2,l-1}(u))])\n=\n\\phi^{\\hat m+1+\\tilde \\imath} \\pr(s_{-j, -m}(e_{2,0})\ns_{i,k}(\\rdet \\Omega_{4,l-1}(u)))\n\n= \\phi^{\\hat m+1+\\tilde \\imath}\n\\delta_{j,m} s_{i,k}(\\rdet \\Omega_{4,l-1}(u)).","source_id":"arXiv:0710.2918","cluster":"quantum_algebra","statement_sha256":"8053faa8dcd3f7a0cd8a9ec0e9daae717e7f996e9c5b247494d072be079601c1","kind":"equation","label":"Equation 6.22","ref_key":"l_6.22","name":"","order":70,"deps":[],"cite_keys":[],"provenance":{"source_url":"https://arxiv.org/abs/0710.2918","harvest_mode":"arxiv_eprint","payload_sha256":"1ec4378974256544801983e594d569faad79a52a5ddec9fe5d4a8ac14b9a35e7","line":2475,"origin":"latex_env:equation","retrieved_at":"2026-09-26T15:01:29+08:00"},"wash":{"version":"cardwash.v2","stages":["segment","purify","classify","dedupe","emit"],"numbering":"document_order_with_label_heuristic","detail":{"stripped_proof":false,"chars":237,"math_hints":33}}},"paper":{"source_id":"arXiv:0710.2918","title":"Twisted Yangians and finite $W$-algebras","abstract":"We construct an explicit set of generators for the finite W-algebras associated to nilpotent matrices in the symplectic or orthogonal Lie algebras whose Jordan blocks are all of the same size. We use these generators to show that such finite W-algebras are quotients of twisted Yangians.","authors":["Jonathan Brown"],"year":"2007","url":"https://arxiv.org/abs/0710.2918","cluster":"quantum_algebra","macros":{"C":"{\\mathbb C}","Z":"{\\mathbb Z}","eps":"\\epsilon","sgn":"{\\operatorname{sgn}}","rdet":"\\operatorname{rdet}","row":"\\operatorname{row}","col":"\\operatorname{col}","gr":"\\operatorname{gr}","ev":"\\operatorname{ev}","pr":"\\operatorname{pr}","trace":"\\operatorname{tr}","mf":"\\mathfrak"},"macros_override":["C","Z","col","eps","ev","gr","mf","pr","rdet","row","sgn","trace"]},"deps":[],"dependents":[]}