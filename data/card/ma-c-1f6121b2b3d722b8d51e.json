{"card":{"card_id":"ma-c-1f6121b2b3d722b8d51e","statement":"\\A # U(\\V) \\cong \\A \\mathop\\otimes\\limits_{\\Lambda} \\DD( \\Lambda, (\\A # \\V)_0 ).","source_id":"arXiv:2006.05618","cluster":"representation_theory","statement_sha256":"2a18887cde0d55f5fc8260e1c8d2f28f5de1a2c9022cf548cffa88ef87f9d8da","kind":"equation","label":"Equation iso","ref_key":"iso","name":"","order":17,"deps":[],"cite_keys":[],"provenance":{"source_url":"https://arxiv.org/abs/2006.05618","harvest_mode":"arxiv_eprint","payload_sha256":"7a371cd4c4c4aab52c55e2601a17686e0fafc32675edff2c56797ff902f10ac0","line":434,"origin":"latex_env:equation","retrieved_at":"2026-09-29T14:19:35+08:00"},"wash":{"version":"cardwash.v2","stages":["segment","purify","classify","dedupe","emit"],"numbering":"document_order_with_label_heuristic","detail":{"stripped_proof":false,"chars":80,"math_hints":13}}},"paper":{"source_id":"arXiv:2006.05618","title":"Classification of simple strong Harish-Chandra $W(m,n)$-modules","abstract":"We classify all simple strong Harish-Chandra modules for the Lie superalgebra $W(m,n)$. We show that every such module is either strongly cuspidal or a module of the highest weight type. We construct tensor modules for $W(m,n)$, which are parametrized by simple finite-dimensional $gl(m,n)$-modules and show that every simple strongly cuspidal $W(m,n)$-module is a quotient of a tensor module. Finally, we realize modules of the highest weight type as simple quotients of the generalized Verma modules induced from tensor modules for $W(m-1,n)$.","authors":["Yuly Billig","Vyacheslav Futorny","Kenji Iohara","Iryna Kashuba"],"year":"2020","url":"https://arxiv.org/abs/2006.05618","cluster":"representation_theory","macros":{"C":"{\\mathbb C}","Z":"{\\mathbb Z}","N":"{\\mathbb N}","K":"{\\mathbb K}","R":"{\\mathcal R}","A":"{\\mathcal A}","AV":"{\\mathcal {AV}}","F":"{\\mathcal F}","V":"{\\mathcal V}","LL":"{\\mathcal L}","HH":"{\\mathcal H}","h":"{\\mathfrak h}","n":"{\\mathfrak n}","hp":"{\\h^\\pr